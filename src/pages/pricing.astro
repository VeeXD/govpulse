---
import Base from '../layouts/Base.astro'; import BgVideo from '../components/BgVideo.astro'; import Pricing from '../components/Pricing.tsx'; import { PAYMENT_LINKS, PROVIDER } from '../config/payments';
---
<Base overlay title="Pricing: Free, Pro and Analyst plans" desc="GovPulse plans: Free, Pro at $9/month or $90/year, Analyst at $29/month, and Enterprise. Unlock all countries, the explorer, CSV export and daily briefs.">
<section class="relative overflow-hidden -mt-16 pt-16"><BgVideo id="india-finance" cls="bg-media opacity-60"/><div class="absolute inset-0 bg-gradient-to-b from-black/50 via-surface/80 to-surface" aria-hidden="true"></div><div class="grain" aria-hidden="true"></div>
<div class="relative mx-auto max-w-7xl px-4 md:px-6 pt-24 pb-10">
 <div class="text-center max-w-2xl mx-auto"><p class="kicker">Pricing</p><h1 class="display mt-5 text-5xl md:text-8xl">Pay for insight, <span class="gold-text">not raw data</span>.</h1><p class="mt-5 text-muted text-lg">The open data stays free. Subscriptions unlock depth: every country, the explorer, exports, alerts and daily briefs.</p></div>
 <div class="mt-12"><Pricing client:load links={PAYMENT_LINKS}/></div>
 <p id="checkout-note" class="text-center text-xs text-muted mt-8">Prices in USD. Checkout is not live yet: payments will run through {PROVIDER}. No account is charged until real checkout links are configured.</p>
</div></section>
</Base>
