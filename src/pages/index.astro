---
import Base from '../layouts/Base.astro'; import Icon from '../components/Icon.tsx';
import ClaimCard from '../components/ClaimCard.astro'; import BgVideo from '../components/BgVideo.astro';
import { COUNTRIES, INDUSTRIES, series, DATA, fmt, claims } from '../lib/data';
import media from '../data/media.json'; import Earth from '../components/Earth.tsx';
const rows = Object.entries(COUNTRIES).map(([id, c]) => { const g = series(id, 'NY.GDP.MKTP.KD.ZG').at(-1); const i = series(id, 'FP.CPI.TOTL.ZG').at(-1); return { id, ...c, g, i }; }).sort((a, b) => (b.g?.[1] ?? -99) - (a.g?.[1] ?? -99));
const nInd = Object.keys(DATA.indicators).length;
const pts = Object.values(DATA.countries).reduce((s: number, c: any) => s + Object.values(c).reduce((t: number, x: any) => t + x.length, 0), 0);
const featured = claims('india')[0];
const ev = (media as any).earth;
---
<Base overlay desc={`Economic dashboards for ${Object.keys(COUNTRIES).length} countries by industry: GDP, inflation, agriculture, healthcare, finance, energy and manufacturing KPIs, all sourced from the World Bank.`}>
<section class="relative h-[100svh] min-h-[640px] overflow-hidden -mt-16" data-parallax>
 <div class="absolute inset-0 bg-[#03060c] bg-[radial-gradient(90%_45%_at_50%_80%,rgba(70,120,255,.18),transparent_70%)]" aria-hidden="true"><img src="/earth/poster.webp" srcset="/earth/poster-m.webp 800w, /earth/poster.webp 1600w" sizes="100vw" alt="" width="1600" height="900" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover"/></div>
 <Earth client:only="react"/>
 <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/70 to-transparent pointer-events-none" aria-hidden="true"></div><div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-surface to-transparent pointer-events-none" aria-hidden="true"></div>
 <div class="relative h-full mx-auto max-w-7xl px-4 md:px-6 flex flex-col justify-start pt-32 md:pt-36 pointer-events-none [&_a]:pointer-events-auto">
  <div data-depth>
   <p class="kicker">Live from {Object.keys(COUNTRIES).length} economies / {nInd} indicators / {pts.toLocaleString()} data points</p>
   <h1 class="display mt-8 text-[clamp(3.6rem,13vw,12.5rem)]">
    <span class="line-mask"><span>The</span></span><span class="line-mask"><span style="transition-delay:.08s">Economic</span></span><span class="line-mask"><span style="transition-delay:.16s"><i class="not-italic text-accent">Pulse</i></span></span>
   </h1>
   <p class="mt-8 max-w-xl text-lg md:text-xl font-extralight text-text">Country-first dashboards by industry. Every number shows its source and date, and every claim gets its counter-metric.</p>
   <div class="mt-10 flex flex-wrap gap-3">
    <a href="/india/agriculture" class="inline-flex items-center gap-2 rounded-full bg-cta text-black font-semibold px-6 py-3 hover:bg-white transition cursor-pointer">Explore India <Icon name="ArrowRight" size={18}/></a>
    <a href="/methodology" class="inline-flex items-center gap-2 rounded-full border border-white/40 px-6 py-3 hover:bg-white/10 transition cursor-pointer"><Icon name="ShieldCheck" size={18}/>How we source data</a>
   </div>
  </div>
 </div>
 <p class="absolute bottom-3 right-4 text-[10px] text-text bg-black/60 backdrop-blur px-2 py-1 rounded">Live WebGL Earth · textures: NASA Blue Marble &amp; Black Marble (public domain) · drag to rotate · <a href="/credits" class="underline">credits</a></p>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-32 md:pt-44 grid md:grid-cols-[1fr_2fr] gap-10 reveal">
 <div class="label-pair"><b>About</b><span>What this is</span></div>
 <p class="text-2xl md:text-4xl font-extralight leading-snug text-strong">Numbers are easy to cherry-pick. GovPulse shows each indicator as a full time series, next to its counterweight, with the source one click away.</p>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 md:pt-40">
 <div class="label-pair reveal"><b>Leaderboard</b><span>Real GDP growth, latest year</span></div>
 <ol class="mt-10 border-t border-white/15">
  {rows.map((r, i) => { const g = r.g?.[1] ?? 0; return <li class="reveal border-b border-white/15"><a href={`/${r.id}#dash`} class="group grid grid-cols-[2.5rem_1fr_auto] md:grid-cols-[4rem_1fr_10rem_8rem] items-baseline gap-4 py-5 md:py-7 hover:pl-3 transition-all cursor-pointer">
   <span class="font-mono text-sm text-muted tabular">{String(i + 1).padStart(2, '0')}</span>
   <span class="text-2xl md:text-5xl font-extralight tracking-tight text-strong group-hover:italic">{r.name}</span>
   <span class:list={['font-mono text-lg md:text-2xl tabular inline-flex items-center gap-1 justify-end', g >= 0 ? 'text-up' : 'text-down']}><Icon name={g >= 0 ? 'ArrowUpRight' : 'ArrowDownRight'} size={18}/><span class="sr-only">{g >= 0 ? 'growth' : 'contraction'}</span>{fmt(r.g?.[1] ?? null, '%')}</span>
   <span class="hidden md:block font-mono text-xs text-muted text-right tabular">CPI {fmt(r.i?.[1] ?? null, '%')} · {r.g?.[0]}</span>
  </a></li>; })}
 </ol>
 <p class="mt-4 text-xs text-muted">Source: World Bank WDI NY.GDP.MKTP.KD.ZG and FP.CPI.TOTL.ZG (CC BY 4.0).</p>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 md:pt-40 grid lg:grid-cols-[1fr_1.2fr] gap-10 items-start">
 <div class="reveal lg:sticky lg:top-28"><div class="label-pair"><b>Claim check</b><span>Data with its counterweight</span></div>
  <p class="mt-6 text-3xl md:text-5xl font-extralight leading-tight text-strong">For every stat, there is another stat.</p>
  <p class="mt-4 text-muted max-w-md">Each card pairs the number a claim relies on with the metric that puts it in context, over the same window.</p></div>
 <div class="reveal">{featured && <ClaimCard c={featured}/>}</div>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 md:pt-40">
 <div class="label-pair reveal"><b>Industries</b><span>Six lenses per country</span></div>
 <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/15 border border-white/15">
  {INDUSTRIES.slice(1).map((i, n) => <a href={`/india/${i.id}`} class="reveal group relative overflow-hidden bg-surface aspect-[4/3] p-6 flex flex-col justify-end cursor-pointer">
   <BgVideo id={i.id} cls="bg-media opacity-50 group-hover:opacity-80 transition-opacity duration-700"/>
   <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
   <span class="relative font-mono text-xs text-muted">{String(n + 1).padStart(2, '0')}</span>
   <span class="relative mt-2 text-3xl font-extralight text-strong flex items-center gap-3"><Icon name={i.icon} size={22}/>{i.name}</span>
  </a>)}
  <a href="/methodology" class="reveal bg-surface aspect-[4/3] p-6 flex flex-col justify-end cursor-pointer hover:bg-raised transition-colors"><span class="font-mono text-xs text-muted">06</span><span class="mt-2 text-3xl font-extralight text-strong">Methodology →</span></a>
 </div>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 md:pt-40 grid md:grid-cols-3 gap-10">
 {[['ShieldCheck', 'Sourced, always', 'Each KPI links to its World Bank indicator with data year and update date.'], ['Scale', 'Context over spin', 'Full time series, share-of-GDP views and counter-metrics on every claim.'], ['Braces', 'Open API', 'Every series is available as static JSON under /api/v1, CC BY 4.0.']].map(([i, t, d]) => <div class="reveal border-t border-white/20 pt-6"><Icon name={i} size={22}/><h2 class="mt-4 text-xl text-strong">{t}</h2><p class="mt-2 text-muted">{d}</p></div>)}
</section>
</Base>
