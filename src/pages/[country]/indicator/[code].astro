---
import Base from '../../../layouts/Base.astro'; import Chart from '../../../components/Chart.tsx';
import { COUNTRIES, INDUSTRIES, DATA, kpis, TOKENS } from '../../../lib/data';
import { lc, slug, unslug, sentence, valText, faqLd, crumbLd } from '../../../lib/seo'; import { SITE } from '../../../config/site';
export function getStaticPaths() { return Object.keys(COUNTRIES).flatMap(country => Object.keys(DATA.indicators).filter(code => (DATA.countries[country]?.[code] ?? []).length).map(code => ({ params: { country, code: slug(code) } }))); }
const { country } = Astro.params; const code = unslug(Astro.params.code!); const C = COUNTRIES[country!];
const m: any = (DATA.indicators as any)[code]; const ind = INDUSTRIES.find(i => i.id === m.industry)!;
const k: any = kpis(country!, m.industry).find((x: any) => x.code === code);
const s = k.series as [number, number][]; const first = s[0], hi = s.reduce((a, b) => b[1] > a[1] ? b : a), lo = s.reduce((a, b) => b[1] < a[1] ? b : a);
const lead = sentence(country!, k);
const extra = `Between ${first[0]} and ${k.year} it ranged from ${valText(lo[1], m.unit)} (${lo[0]}) to ${valText(hi[1], m.unit)} (${hi[0]}).`;
const title = `${C.name} ${lc(m.label)} ${k.year}: ${valText(k.value, m.unit)} · data ${first[0]}–${k.year}`;
const peers = Object.entries(COUNTRIES).filter(([id]) => id !== country && (DATA.countries[id]?.[code] ?? []).length).map(([id, c]) => { const x: any = kpis(id, m.industry).find((y: any) => y.code === code); return { id, name: c.name, v: x?.value, y: x?.year }; });
const related = kpis(country!, m.industry).filter((x: any) => x.code !== code && x.value != null);
const faq = [[`What is ${C.name}'s ${lc(m.label)}?`, lead!], [`How has it changed since ${first[0]}?`, extra], [`What is the source?`, `World Bank World Development Indicators, series ${code}${m.note ? ' (' + m.note + ')' : ''}. Licence CC BY 4.0. Download: ${SITE}/api/v1/${country}/${code}.json`]];
const url = `${SITE}/${country}/indicator/${Astro.params.code}/`;
const ld = [faqLd(faq), crumbLd([['Home', `${SITE}/`], [C.name, `${SITE}/${country}/`], [ind.name, `${SITE}/${country}/${ind.id === 'overview' ? '' : ind.id + '/'}`], [m.label, url]]),
  { '@context': 'https://schema.org', '@type': 'Dataset', name: `${C.name}: ${m.label} (${m.unit}), ${first[0]}–${k.year}`, description: `${lead} ${extra}`, url, license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true, creator: { '@type': 'Organization', name: 'The World Bank', url: 'https://data.worldbank.org/' }, spatialCoverage: { '@type': 'Place', name: C.name }, temporalCoverage: `${first[0]}/${k.year}`, variableMeasured: { '@type': 'PropertyValue', name: m.label, unitText: m.unit, value: k.value }, dateModified: DATA.generated, distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE}/api/v1/${country}/${code}.json` }] }];
---
<Base title={title} desc={`${lead} ${extra}`.slice(0, 300)} og={`/og/${country}.png`} jsonld={ld}>
<div class="mx-auto max-w-5xl px-4 md:px-6 pt-12 pb-8 [overflow-wrap:anywhere]">
 <nav aria-label="Breadcrumb" class="text-xs text-muted"><a href="/" class="hover:underline">Home</a> / <a href={`/${country}/`} class="hover:underline">{C.name}</a> / <a href={`/${country}/${ind.id === 'overview' ? '' : ind.id + '/'}`} class="hover:underline">{ind.name}</a> / <span>{m.label}</span></nav>
 <p class="kicker mt-8">{C.name} / {ind.name} / {code}</p>
 <h1 class="display mt-4 text-[clamp(2.2rem,8vw,5rem)]">{C.name} {lc(m.label)}</h1>
 <p class="mt-4 font-mono text-5xl text-accent">{valText(k.value, m.unit)} <span class="text-base text-muted">({k.year})</span></p>
 <div class="mt-6 grid gap-2 text-lg font-extralight max-w-3xl"><p>{lead}</p><p>{extra}</p></div>
 <div class="edge rounded-2xl p-5 mt-8"><Chart client:visible series={[{ name: `${m.label} (${m.unit})`, data: s, unit: m.unit }]} colors={[TOKENS.accent]} height={300} title={`${C.name}: ${m.label}`} source={`World Bank WDI ${code}, CC BY 4.0`}/></div>
 <section class="mt-10 grid gap-8 md:grid-cols-2">
  <div><h2 class="text-xl font-semibold">{m.label} in other countries</h2><ul class="mt-3 grid gap-1 text-sm">{peers.map(p => <li class="flex justify-between gap-3 border-b border-white/10 py-1.5"><a class="underline underline-offset-2 hover:text-accent" href={`/${p.id}/indicator/${Astro.params.code}/`}>{p.name}</a><span class="font-mono tabular-nums text-muted">{valText(p.v, m.unit)} ({p.y})</span></li>)}</ul></div>
  <div><h2 class="text-xl font-semibold">Related {C.name} indicators</h2><ul class="mt-3 grid gap-1 text-sm">{related.map((x: any) => <li><a class="underline underline-offset-2 hover:text-accent" href={`/${country}/indicator/${slug(x.code)}/`}>{x.label}</a>: <span class="text-muted">{valText(x.value, x.unit)} ({x.year})</span></li>)}</ul>
   <h2 class="text-xl font-semibold mt-8">FAQ</h2><div class="mt-3 grid gap-2">{faq.map(([q, a]) => <details class="edge rounded-xl p-4"><summary class="cursor-pointer font-semibold text-sm">{q}</summary><p class="mt-2 text-sm text-muted">{a}</p></details>)}</div></div>
 </section>
 <details class="mt-10 edge rounded-2xl p-5"><summary class="cursor-pointer font-semibold">All values, {first[0]}–{k.year}</summary><table class="mt-4 w-full text-sm tabular-nums"><caption class="sr-only">{C.name} {m.label} by year</caption><thead><tr class="text-left text-muted"><th class="py-1">Year</th><th class="py-1">Value ({m.unit})</th></tr></thead><tbody>{[...s].reverse().map(([y, v]) => <tr class="border-t border-white/10"><td class="py-1">{y}</td><td class="py-1 font-mono">{v.toFixed(2)}</td></tr>)}</tbody></table></details>
</div>
</Base>
