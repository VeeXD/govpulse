---
import Base from '../layouts/Base.astro'; import IndustryDots from '../components/IndustryDots.tsx'; import Icon from '../components/Icon.tsx';
import { TIERS, ZELLE_EMAIL, SPONSORS } from '../config/sponsors'; import { CONTACT_EMAIL, SITE } from '../config/site'; import { COUNTRIES } from '../lib/data';
const faq = [
  ['Is GovPulse free?', 'Yes. Every dashboard, chart, filter and the public JSON API are free. Sponsors and supporters pay for hosting, data pipelines and new coverage.'],
  ['Can a sponsor change or remove data?', 'No. Sponsors never see data before publication, cannot request changes, and have no say over rankings, claim checks or editorial text.'],
  ['How do I pay?', `Send a Zelle payment to ${ZELLE_EMAIL} and email ${CONTACT_EMAIL} with your organisation name, tier and logo.`],
];
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: 'Sponsor', item: `${SITE}/sponsor/` }] }];
const all = [...SPONSORS.gold, ...SPONSORS.silver, ...SPONSORS.bronze];
---
<Base overlay title="Sponsor GovPulse: fund free, open economic data" desc="GovPulse is free for everyone. Sponsor it to fund new countries, data sources and features. Tiers from any amount to Gold, with a strict no-influence disclosure policy." jsonld={ld}>
<header class="page-hero -mt-16 pt-16">
 <div class="absolute inset-0 opacity-90" aria-hidden="true"><IndustryDots client:visible industry="energy" density={0.8} morph={false}/></div><div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/70 to-transparent pointer-events-none" aria-hidden="true"></div>
 <div class="relative mx-auto max-w-5xl px-4 md:px-6 pt-24 pb-16"><p class="kicker">Support GovPulse</p>
  <h1 class="display mt-4 text-[clamp(2.3rem,10.5vw,6rem)] break-words">Keep economic data <span class="gold-text">free.</span></h1>
  <p class="mt-6 max-w-2xl text-lg font-extralight">GovPulse is free for everyone: {Object.keys(COUNTRIES).length} countries, every industry dashboard, filters and a public API. Sponsorship pays for the rest.</p>
  <div class="mt-8 flex flex-wrap gap-3"><a href="#pay" class="inline-flex items-center gap-2 rounded-full bg-cta text-black font-semibold px-6 py-3 hover:bg-white transition"><Icon name="Heart" size={18}/>Sponsor via Zelle</a><a href={`mailto:${CONTACT_EMAIL}?subject=GovPulse%20sponsorship`} class="inline-flex items-center gap-2 rounded-full border border-white/40 px-6 py-3 hover:bg-white/10 transition"><Icon name="Mail" size={18}/>Sponsorship inquiries</a></div>
 </div>
</header>
<div class="mx-auto max-w-6xl px-4 md:px-6 pt-12 grid gap-16">
 <section aria-labelledby="why"><div class="label-pair"><b id="why">Why sponsor</b><span>What your money funds</span></div>
  <div class="mt-8 grid gap-4 md:grid-cols-3">{[['Database', 'New data sources', 'IMF, OECD, national statistics offices and official gazettes for policy tracking.'], ['Globe', 'More countries', 'Moving from 10 economies towards full World Bank coverage.'], ['Sparkles', 'New features', 'Indicator comparisons, country-vs-country views, alerts and a daily brief, all free.']].map(([i, t, d]) => <div class="edge tilt rounded-2xl p-6"><Icon name={i} size={22}/><h2 class="mt-4 text-lg font-semibold">{t}</h2><p class="mt-2 text-sm text-muted">{d}</p></div>)}</div>
 </section>
 <section aria-labelledby="tiers"><div class="label-pair"><b id="tiers">Tiers</b><span>Suggested, monthly</span></div>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{TIERS.map((t, i) => <article class:list={['edge rounded-2xl p-6 flex flex-col', i === 3 && 'glow-amber']}><h3 class="text-lg font-semibold">{t.name}</h3><p class="mt-3 font-mono text-3xl">{t.price}</p><ul class="mt-5 grid gap-2 text-sm">{t.perks.map(p => <li class="flex gap-2"><Icon name="Check" size={16}/><span>{p}</span></li>)}</ul></article>)}</div>
 </section>
 <section id="pay" aria-labelledby="payh" class="edge glow-amber rounded-2xl p-6 md:p-8 scroll-mt-24"><h2 id="payh" class="text-2xl font-semibold">How to sponsor</h2>
  <ol class="mt-4 grid gap-2 text-text list-decimal pl-5"><li>Send any amount by <b>Zelle</b> to <span class="font-mono text-accent break-all">{ZELLE_EMAIL}</span> (memo: "GovPulse" plus your tier).</li><li>Email <a class="underline" href={`mailto:${CONTACT_EMAIL}?subject=GovPulse%20sponsorship`}>{CONTACT_EMAIL}</a> with your organisation name, tier, website and an SVG or PNG logo.</li><li>We add your logo within 3 working days. Cancel any time by stopping payments.</li></ol>
  <p class="mt-4 text-xs text-muted">Zelle is only available between US bank accounts. If you're outside the US, email us and we'll suggest another way to pay. Sponsorships aren't tax-deductible donations.</p>
 </section>
 <section id="disclosure" aria-labelledby="disc" class="scroll-mt-24"><div class="label-pair"><b id="disc">Sponsorship disclosure</b><span>Our policy</span></div>
  <ul class="mt-6 grid gap-3 text-text max-w-3xl list-disc pl-5"><li>Sponsors <b>never</b> influence data, indicators, rankings, claim checks or editorial text.</li><li>All numbers come from public sources (mainly the World Bank, CC BY 4.0) through an automated pipeline. Sponsors don't see them before publication.</li><li>Sponsored placements are always labelled "Supported by" or "Presented by" and link to this policy. Sponsor links carry <code>rel="sponsored"</code>.</li><li>We may decline or end a sponsorship that conflicts with this policy. Current sponsors: {all.length ? all.map(s => s.name).join(', ') : 'none yet'}.</li></ul>
 </section>
 <section aria-labelledby="faqh"><div class="label-pair"><b id="faqh">FAQ</b><span>Sponsorship</span></div>
  <div class="mt-6 grid gap-3">{faq.map(([q, a]) => <details class="edge rounded-xl p-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm text-muted">{a}</p></details>)}</div>
 </section>
</div>
</Base>
