---
import Base from '../layouts/Base.astro'; import NewsBrowser from '../components/NewsBrowser.tsx'; import { NEWS, CATS } from '../lib/news'; import { COUNTRIES } from '../lib/data';
const countries = Object.fromEntries(Object.entries(COUNTRIES).map(([k, v]) => [k, v.name]));
const initial = Object.entries(NEWS.countries).flatMap(([k, v]) => v.slice(0, 6).map(x => ({ ...x, country: k }))).sort((a, b) => b.time.localeCompare(a.time));
const title = 'Latest government, business & economy news by country';
const desc = `Live headlines on politics, business, companies and economic trends for ${Object.values(countries).join(', ')}. Updated every 2 hours from Google News, GDELT and official central bank and government feeds.`;
---
<Base title={title} desc={desc}>
<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 pb-16">
 <p class="kicker">Updated {NEWS.generated.replace('T', ' ').replace('Z', '')} UTC · refreshes every 2 hours</p>
 <h1 class="mt-3 text-4xl md:text-6xl font-extralight text-strong">Latest news</h1>
 <p class="mt-4 max-w-3xl text-muted">Headlines on politics, business, companies and the economy for every GovPulse country. Filter by country or topic, or search for a company or institution. Pair a headline with the numbers on each <a href="/latest-trends/" class="underline underline-offset-2">latest trends</a> page.</p>
 <div class="mt-8"><NewsBrowser client:load countries={countries} cats={CATS} initial={initial} generated={NEWS.generated}/></div>
 <p class="mt-8 text-xs text-muted max-w-3xl">Headlines link to the original publishers and open on their sites. GovPulse stores only the headline, source, time and link, never article text, and does not write, edit or endorse these stories. Sources: Google News RSS, the GDELT Project, and official feeds from the Federal Reserve, The White House, the Reserve Bank of India, the Bank of England and the European Central Bank. Spotted a problem? <a href="/contact" class="underline underline-offset-2">Contact us</a>.</p>
</section>
</Base>
