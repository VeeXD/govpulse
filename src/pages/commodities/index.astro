---
import Base from '../../layouts/Base.astro'; import { CM, NAMES, area, tonnes, usd, cropName } from '../../lib/commodity';
const title = 'Commodity explorer: crop production, trade & manufacturing by country';
const desc = 'Who grows the world\'s wheat, rice, maize, soybeans and more (FAOSTAT), what each country exports and imports by HS chapter (UN Comtrade), and how manufacturing output ranks and shows up in trade.';
const crops = Object.entries(CM.crops) as [string, any][];
const ld = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'GovPulse commodity explorer', description: desc, url: 'https://govpulse.pages.dev/commodities/', dateModified: CM.generated, isAccessibleForFree: true, license: 'https://creativecommons.org/licenses/by/4.0/', creator: { '@type': 'Organization', name: 'GovPulse', url: 'https://govpulse.pages.dev' }, citation: [CM.fao?.source, CM.comtrade?.source, CM.wb?.source].filter(Boolean), variableMeasured: ['Crop production (tonnes)', 'Exports by HS chapter (US$)', 'Imports by HS chapter (US$)', 'Manufacturing value added (current US$)'] };
const ids = Object.keys(NAMES).filter(k => CM.trade[k]);
---
<Base title={title} desc={desc} jsonld={[ld]}>
<section class="mx-auto max-w-7xl px-4 md:px-6 pt-28 pb-16">
 <p class="kicker">Commodity explorer · MVP</p>
 <h1 class="mt-3 text-4xl md:text-6xl font-extralight text-strong">Commodities</h1>
 <p class="mt-4 max-w-3xl text-muted">Where the world's crops are grown, what each country sells and buys abroad, and how big its factories are. Every figure below comes straight from FAOSTAT, UN Comtrade or the World Bank; nothing is estimated by GovPulse.</p>
 <h2 class="mt-12 text-2xl font-light text-strong">Crop production</h2>
 <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-5 gap-3">{crops.map(([s, c]) => <a href={`/commodities/${s}/`} class="edge rounded-xl p-4 hover:border-accent block"><p class="font-semibold text-strong">{cropName(s)}</p><p class="mt-1 font-mono text-lg">{tonnes(c.world)}</p><p class="text-xs text-muted">world, {c.year}</p><p class="mt-2 text-xs text-muted">#1 {area(c.top[0].area)} · {c.top[0].share.toFixed(1)}%</p></a>)}</div>
 <h2 id="trade" class="mt-14 text-2xl font-light text-strong">Manufacturing and trade</h2>
 <p class="mt-2 max-w-3xl text-sm text-muted">Manufacturing rank is by World Bank manufacturing value added (current US$) among {CM.manufacturing.india?.of} economies, using each economy's latest reported year. "Manufactured share" is the share of goods exports in {CM.comtrade.manufDef}.</p>
 <div class="mt-4 overflow-x-auto edge rounded-2xl"><table class="w-full text-sm tabular-nums min-w-[900px]"><caption class="sr-only">Manufacturing and trade by country</caption>
  <thead><tr class="text-left text-muted border-b border-white/10"><th class="p-3">Country</th><th class="p-3">Manufacturing value added</th><th class="p-3">World rank</th><th class="p-3">Goods exports</th><th class="p-3">Manufactured share</th><th class="p-3">Top export</th><th class="p-3">Top import</th></tr></thead>
  <tbody>{ids.map(k => { const m = CM.manufacturing[k], t = CM.trade[k]; return <tr class="border-b border-white/10 align-top"><th class="p-3 text-left"><a href={`#t-${k}`} class="hover:text-accent">{NAMES[k]}</a></th><td class="p-3 font-mono">{m ? `${usd(m.value)} (${m.year})` : '—'}</td><td class="p-3 font-mono">{m ? `#${m.rank}` : '—'}</td><td class="p-3 font-mono">{usd(t.X.total)} ({t.year})</td><td class="p-3 font-mono">{t.X.manufShare}%</td><td class="p-3">{t.X.top[0].desc.split(/[;,]/)[0]} <span class="text-muted">{t.X.top[0].share}%</span></td><td class="p-3">{t.M.top[0].desc.split(/[;,]/)[0]} <span class="text-muted">{t.M.top[0].share}%</span></td></tr>; })}</tbody></table></div>
 <div class="mt-10 grid lg:grid-cols-2 gap-4">{ids.map(k => { const t = CM.trade[k]; const m = CM.manufacturing[k]; return <article id={`t-${k}`} class="edge rounded-2xl p-5">
  <h3 class="text-lg font-semibold text-strong">{NAMES[k]} · trade by commodity, {t.year}</h3>
  <p class="mt-1 text-sm text-muted">{NAMES[k]} exported {usd(t.X.total)} and imported {usd(t.M.total)} of goods in {t.year}{m ? `; its manufacturing value added ranks #${m.rank} in the world` : ''}. {t.X.manufShare}% of exports were manufactured goods, versus {t.M.manufShare}% of imports.</p>
  <div class="mt-3 grid sm:grid-cols-2 gap-4 text-xs">{(['X', 'M'] as const).map(f => <div><p class="kicker mb-1">Top {f === 'X' ? 'exports' : 'imports'}</p><ol class="space-y-1">{t[f].top.slice(0, 6).map((x: any) => <li class="flex gap-2"><span class="font-mono text-muted w-6">{x.hs}</span><span class="flex-1 truncate" title={x.desc}>{x.desc}</span><span class={`font-mono ${x.manuf ? 'text-accent' : ''}`}>{x.share}%</span></li>)}</ol></div>)}</div>
  <p class="mt-3 text-[11px] text-muted">HS 2-digit chapters, partner = World. <span class="text-accent">Amber</span> = manufactured chapter. <a href={`/${k}/`} class="underline underline-offset-2">{NAMES[k]} dashboard</a></p></article>; })}</div>
 <p class="mt-8 text-xs text-muted">Sources: <a href={CM.fao?.url} class="underline">{CM.fao?.source}</a>; <a href={CM.comtrade.url} class="underline">{CM.comtrade.source}</a>; <a href={CM.wb?.url} class="underline">{CM.wb?.source}</a>. Updated {CM.generated.replace('T', ' ')} UTC. FAOSTAT "China, mainland" excludes Hong Kong, Macao and Taiwan.</p>
</section>
</Base>
