---
import Base from '../layouts/Base.astro';
import Chart from './Chart.tsx';
import IndustryDots from './IndustryDots.tsx';
import { valText, slug, lc } from '../lib/seo';
import { COUNTRIES } from '../lib/data';
const p = Astro.props.page as any;
const C = COUNTRIES[p.country];
const ld = [p.faqLd, p.crumbs, p.dataset];
const wordApprox = p.summary.split(/\s+/).length;
---
<Base overlay title={p.title} desc={p.desc} jsonld={ld}>
<header class="page-hero -mt-16 pt-16">
 <div class="absolute inset-0 opacity-90" aria-hidden="true"><IndustryDots client:visible industry={p.def.dots} density={0.7} morph={false}/></div>
 <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/75 to-transparent pointer-events-none" aria-hidden="true"></div>
 <div class="relative mx-auto max-w-6xl px-4 md:px-6 pt-24 pb-14">
  <nav aria-label="Breadcrumb" class="text-xs text-muted">
   <a href="/" class="hover:underline">Home</a> / <a href={p.countryHref} class="hover:underline">{C.name}</a> / <span>{p.h1}</span>
  </nav>
  <p class="kicker mt-6">{C.name} · World Bank / open data</p>
  <h1 class="display mt-4 text-[clamp(2.1rem,7vw,4.8rem)] break-words">{p.h1}</h1>
  {p.value != null && p.topic !== 'top-exports' && (
    <p class="mt-4 font-mono text-4xl md:text-5xl text-accent">{valText(p.value, p.unit)} <span class="text-base text-muted">({p.year})</span></p>
  )}
  <p class="mt-6 max-w-3xl text-lg font-extralight leading-relaxed">{p.summary}</p>
  <p class="mt-3 text-xs text-muted">~{wordApprox} words · pipeline {p.generated.slice(0, 10)} UTC · not financial advice</p>
  <p class="mt-6 flex flex-wrap gap-3 text-sm">
   <a href={p.dashHref} class="rounded-full bg-cta text-black font-semibold px-4 py-2">Open in Dashboards →</a>
   <a href={p.countryHref} class="rounded-full border border-white/25 px-4 py-2 hover:border-accent hover:text-accent">{C.name} economy</a>
   {p.code && <a href={`/${p.country}/indicator/${slug(p.code)}/`} class="rounded-full border border-white/25 px-4 py-2 hover:border-accent hover:text-accent">Full indicator series</a>}
  </p>
 </div>
</header>

<div class="mx-auto max-w-6xl px-4 md:px-6 pt-10 grid gap-12 [overflow-wrap:anywhere]">
 {p.topic === 'top-exports' && p.exportRows?.length ? (
  <section aria-labelledby="exp"><h2 id="exp" class="text-2xl font-semibold">Top export chapters</h2>
   <div class="tw mt-4 edge rounded-2xl p-2"><table><thead><tr><th>#</th><th>HS</th><th>Product</th><th>Value</th></tr></thead>
   <tbody>{p.exportRows.map((r: any, i: number) => <tr><td>{i + 1}</td><td class="font-mono">{r.h}</td><td>{r.name}</td><td class="font-mono tabular-nums">{r.v >= 1e9 ? `US$${(r.v / 1e9).toFixed(1)} bn` : `US$${(r.v / 1e6).toFixed(0)} m`}</td></tr>)}</tbody></table></div>
   {p.partners?.length > 0 && <p class="mt-4 text-sm text-muted">Top destinations ({p.tradeYear}): {p.partners.map((x: any) => `${x.name} ${x.share}%`).join(' · ')}</p>}
  </section>
 ) : (
  <section aria-labelledby="ch"><h2 id="ch" class="text-2xl font-semibold sr-only">Chart</h2>
   <div class="edge rounded-2xl p-5"><Chart client:visible series={[{ name: p.chartTitle, data: p.seriesData, unit: p.unit }]} colors={[p.tokens.accent]} height={320} title={p.chartTitle} kind={p.chartKind === 'bar' ? 'bar' : 'area'} source={`World Bank WDI ${p.code || ''}, CC BY 4.0 · ${p.generated.slice(0, 10)}`}/></div>
  </section>
 )}

 {p.topic === 'health-statistics' && p.healthExtra && (
  <section aria-labelledby="hk"><h2 id="hk" class="text-2xl font-semibold">{C.name} health indicators</h2>
   <ul class="mt-4 grid sm:grid-cols-2 gap-3 text-sm">{[
     p.healthExtra.he && ['Health expenditure', valText(p.healthExtra.he.v, '% GDP'), p.healthExtra.he.y, 'SH.XPD.CHEX.GD.ZS'],
     p.healthExtra.le && ['Life expectancy', `${p.healthExtra.le.v.toFixed(1)} years`, p.healthExtra.le.y, 'SP.DYN.LE00.IN'],
     p.healthExtra.im && ['Infant mortality', `${p.healthExtra.im.v.toFixed(1)} / 1,000`, p.healthExtra.im.y, 'SP.DYN.IMRT.IN'],
     p.healthExtra.ph && ['Physicians', `${p.healthExtra.ph.v.toFixed(2)} / 1,000`, p.healthExtra.ph.y, 'SH.MED.PHYS.ZS'],
   ].filter(Boolean).map((row: any) => <li class="edge rounded-xl p-4 flex justify-between gap-3"><span><a class="underline underline-offset-2 hover:text-accent" href={`/${p.country}/indicator/${slug(row[3])}/`}>{row[0]}</a><span class="block text-xs text-muted">{row[3]} · {row[2]}</span></span><span class="font-mono text-accent">{row[1]}</span></li>)}</ul>
  </section>
 )}

 {p.peerRows?.length > 0 && (
  <section aria-labelledby="peers"><h2 id="peers" class="text-2xl font-semibold">Same metric, other countries</h2>
   <ol class="mt-4 grid gap-2 md:grid-cols-2">{p.peerRows.map((x: any, i: number) => <li class="edge rounded-xl p-4 flex justify-between gap-3"><span>{i + 1}. <a class="underline underline-offset-2 hover:text-accent" href={x.href}>{x.name}</a></span><span class="font-mono tabular-nums text-muted">{valText(x.v, p.unit)} ({x.y})</span></li>)}</ol>
  </section>
 )}

 <section aria-labelledby="faq"><h2 id="faq" class="text-2xl font-semibold">Frequently asked questions</h2>
  <div class="mt-4 grid gap-3">{p.faq.map(([q, a]: [string, string]) => <details class="edge rounded-xl p-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm text-muted leading-relaxed">{a}</p></details>)}</div>
 </section>

 <section aria-labelledby="rel"><h2 id="rel" class="text-2xl font-semibold">Related pages</h2>
  <ul class="mt-4 flex flex-wrap gap-2 text-sm">
   {p.related.map((r: any) => <li><a class="rounded-full border border-white/15 px-3 py-1.5 hover:border-accent hover:text-accent" href={r.href}>{r.label}</a></li>)}
   {p.rankLinks.map((r: any) => <li><a class="rounded-full border border-white/15 px-3 py-1.5 hover:border-accent hover:text-accent" href={r.href}>{r.label}</a></li>)}
   <li><a class="rounded-full border border-white/15 px-3 py-1.5 hover:border-accent hover:text-accent" href="/gdp-by-country/">GDP by country</a></li>
   <li><a class="rounded-full border border-accent/40 px-3 py-1.5 text-accent" href={p.dashHref}>Open in Dashboards</a></li>
  </ul>
 </section>
</div>
</Base>
