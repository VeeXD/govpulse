---
import Base from '../layouts/Base.astro'; import IndustryDots from './IndustryDots.tsx'; import { faqLd, crumbLd } from '../lib/seo'; import { SITE } from '../config/site';
const { title, h1, kicker, lead, desc, faq = [], path, dots = 'overview', extraLd = [] } = Astro.props;
const ld = [faqLd(faq), crumbLd([['Home', `${SITE}/`], [h1, `${SITE}${path}`]]), ...extraLd];
---
<Base overlay title={title} desc={desc} jsonld={ld}>
<header class="page-hero -mt-16 pt-16">
 <div class="absolute inset-0 opacity-90" aria-hidden="true"><IndustryDots client:visible industry={dots} density={0.7} morph={false}/></div><div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/75 to-transparent pointer-events-none" aria-hidden="true"></div>
 <div class="relative mx-auto max-w-6xl px-4 md:px-6 pt-24 pb-14">
  <nav aria-label="Breadcrumb" class="text-xs text-muted"><a href="/" class="hover:underline">Home</a> / <span>{h1}</span></nav>
  <p class="kicker mt-6">{kicker}</p><h1 class="display mt-4 text-[clamp(2.3rem,8vw,5.5rem)] break-words">{h1}</h1>
  <p class="mt-6 max-w-3xl text-lg font-extralight">{lead}</p>
 </div>
</header>
<div class="mx-auto max-w-6xl px-4 md:px-6 pt-10 grid gap-12 [overflow-wrap:anywhere] land">
 <slot/>
 {faq.length > 0 && <section aria-labelledby="faq"><h2 id="faq" class="text-2xl font-semibold">Frequently asked questions</h2><div class="mt-4 grid gap-3">{faq.map(([q, a]: any) => <details class="edge rounded-xl p-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm text-muted">{a}</p></details>)}</div></section>}
 <section class="edge glow-amber rounded-2xl p-6 text-sm">Explore further: <a class="underline" href="/gdp-by-country/">GDP by country</a> · <a class="underline" href="/economic-indicators-dashboard/">Economic indicators dashboard</a> · <a class="underline" href="/government-analytics/">Government analytics</a> · <a class="underline" href="/policy-tracker/">Policy tracker</a> · <a class="underline" href="/reports/">Economic reports</a> · <a class="underline" href="/api/">Free JSON API</a></section>
</div>
<style is:global>.land table{width:100%;font-size:.875rem;font-variant-numeric:tabular-nums}.land th,.land td{padding:.45rem .6rem;text-align:left;border-bottom:1px solid rgba(255,255,255,.08)}.land th{color:var(--color-muted);font-weight:400}.land .tw{overflow-x:auto}.land h2{font-size:1.5rem;font-weight:600}</style>
</Base>
