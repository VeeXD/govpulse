---
import heroes from '../data/heroes.json'; import media from '../data/media.json';
import BgVideo from './BgVideo.astro'; import Icon from './Icon.tsx';
const { country, name, region, iso, sub, h1sub } = Astro.props;
const h = (heroes as any)[country]; const v = (media as any)[country]; const sp = (media as any)[`${country}-photo`];
const words = name.split(' ');
---
<section class="relative h-[100svh] min-h-[600px] max-h-[1100px] overflow-hidden -mt-16" data-parallax>
 {sp ? <div class="hero-media hero-bright" aria-hidden="true"><img src={sp.files.webp} srcset={`${sp.files.webpM} 960w, ${sp.files.webp} 1920w`} sizes="100vw" alt="" width="1920" height="1200" fetchpriority="high" decoding="async"/></div>
  <div class="absolute inset-x-0 bottom-0 h-[65%] bg-gradient-to-t from-black/75 via-black/30 to-transparent" aria-hidden="true"></div><div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/50 to-transparent" aria-hidden="true"></div>
 : <><BgVideo id={country} photo={country} cls="hero-media"/><div class="grade-tone" aria-hidden="true"></div><div class="grade-vignette" aria-hidden="true"></div></>}<div class="grain" aria-hidden="true"></div>
 <div class="relative h-full mx-auto max-w-7xl px-4 md:px-6 flex flex-col justify-end pb-20 md:pb-28">
  <div data-depth>
   <p class="kicker flex items-center gap-3"><span class="h-px w-12 bg-white/60"></span>{region} / {iso}</p>
   <h1 class="display mt-6 text-[clamp(3.4rem,12vw,11rem)]">{words.map(w => <span class="line-mask"><span>{w}</span></span>)}{h1sub && <span class="block mt-4 font-sans text-base md:text-xl tracking-[0.2em] uppercase text-accent not-italic">{h1sub}</span>}</h1>
   <p class="mt-8 text-lg md:text-2xl font-extralight text-text max-w-2xl">{sub}</p>
  </div>
  <a href="#dash" class="mt-10 inline-flex items-center gap-3 kicker hover:text-strong w-fit cursor-pointer"><Icon name="ArrowDown" size={16}/>Scroll</a>
 </div>
</section>
