---
import Icon from './Icon.tsx'; import { fmt } from '../lib/data';
const { c } = Astro.props;
const arrow = (d: number) => (d > 0 ? 'ArrowUpRight' : d < 0 ? 'ArrowDownRight' : 'ArrowRight');
---
<article class="spot glass rounded-2xl p-5 sm:p-6 flex flex-col gap-4 min-w-0" data-claim>
 <div class="flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-accent"><Icon name="ScanSearch" size={15}/>Claim check</div>
 <p class="text-lg font-semibold leading-snug break-words">{c.claim}</p>
 <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-3 min-w-0">
  {[['The data', c.a, 'border-primary/50'], ['Counter-metric', c.b, 'border-accent/50']].map(([t, x, b]: any) => (
   <div class:list={['rounded-xl bg-surface/60 border p-3 min-w-0', b]}>
    <div class="text-[11px] uppercase tracking-wider text-muted">{t}</div>
    <div class="text-sm mt-1 break-words">{x.label} <span class="text-muted">({x.unit})</span></div>
    <dl class="font-mono mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
     <dt class="text-muted">{x.from[0]}</dt><dd class="text-right">{fmt(x.from[1], x.unit)}</dd>
     <dt class="text-muted">{x.to[0]}</dt><dd class="text-right font-semibold">{fmt(x.to[1], x.unit)}</dd>
    </dl>
    <div class="font-mono text-xs mt-1.5 flex items-center gap-1 text-muted tabular-nums"><Icon name={arrow(x.diff)} size={13}/><span class="sr-only">{x.diff > 0 ? 'increase' : x.diff < 0 ? 'decrease' : 'no change'}</span>{x.diff >= 0 ? '+' : ''}{x.diff.toFixed(1)} change</div>
   </div>))}
 </div>
 <p class="text-sm text-muted leading-relaxed">{c.note}</p>
 <p class="text-[11px] text-muted mt-auto break-words">Sources: World Bank {c.a.code}, {c.b.code}. Claim wording is a generic template, not a quote.</p>
</article>
